{
  "manifest_version": 3,
  "name": "Dots Bridge Kit",
  "version": "0.2.8",
  "key": "",
  "description": "Connect your configured Dot to your local text and voice bridges.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/dots/*"
      ],
      "js": [
        "watch.js",
        "call-control.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Dots Bridge Kit — open your Dot"
  }
}
